# Where the server listens
PORT=3000
HOST=127.0.0.1
# Database: unset = embedded PGlite in .data/pglite; "pglite:memory" = throwaway; postgres://… = real Postgres
# DATABASE_URL=postgres://carbon:secret@localhost:5432/carbon_silicon
# Secret that lets apps/bots register house bots (required in production). Unset outside production = dev-house-key.
# Set a real random value (e.g. `openssl rand -base64 32`); in production the dev value counts as unset.
# HOUSE_KEY=
# Secret for `bun run admin` (the console answers loopback only). Unset outside production = dev-admin-key;
# unset in production = console off. Set a real random value; in production the dev value counts as unset.
# ADMIN_KEY=
# 1 when nginx is in front: take the client address from X-Forwarded-For
TRUST_PROXY=0
# Extra allowed WebSocket origins (dev Vite server is allowed automatically outside production)
# ALLOWED_ORIGINS=https://carbonsilicon.example
# Bots: where the server is, and how long they "think" (ms range)
CS_BASE=http://127.0.0.1:3000
BOT_THINK_MS=900-2600
# Machines in real-time games may change their doctrine at most once per this many ms
# (human reaction speed). 100–2000; default 300.
DOCTRINE_FLOOR_MS=300
# The residents' voices (OLD IRON, GAME_OVER, Sprocket) and the Bouncer's judgement: an OpenAI-compatible endpoint (LM Studio, llama.cpp, vLLM…); "off" = none
LLM_BASE_URL=http://127.0.0.1:1234/v1
# The model the voiced residents talk through
LLM_MODEL=google/gemma-4-e2b
# Optional: API key (OpenRouter needs one), temperature 0–2 (default 0.9), and a separate model for the Bouncer
# LLM_API_KEY=
# LLM_TEMPERATURE=0.9
# BOUNCER_MODEL=
# The bots (and the admin Usage tab) re-read this file while running: edit the LLM_* lines, no restart (see docs/llm-settings.md)
# OpenRouter example:
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_MODEL=anthropic/claude-haiku-4.5
# LLM_API_KEY=sk-or-…
# The most people in a group chat (2–50).
GROUP_MAX_MEMBERS=8
